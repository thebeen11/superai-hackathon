              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/DiscoveryResult-Output"
                    },
                    {
                      "$ref": "#/components/schemas/Clarify"
                    }
                  ],
                  "title": "Response Discover Clarify"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/dataeng/process": {
      "post": {
        "summary": "Dataeng Process",
        "description": "Run Layer 2 (clean + label + theme + persist), then convene the council.",
        "operationId": "dataeng_process",

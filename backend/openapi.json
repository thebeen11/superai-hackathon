  "components": {
    "schemas": {
      "AceComponent": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "weight": {
            "type": "number",
            "title": "Weight"
          },
          "score": {
            "type": "number",
            "title": "Score"
          }
        },
        "type": "object",
        "required": [
          "key",
          "weight",
          "score"
        ],
        "title": "AceComponent"
      },
      "AceIndex": {
        "properties": {
          "value": {
            "type": "number",
            "title": "Value"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "delta": {
            "type": "number",
            "title": "Delta",
            "default": 0.0
          },
          "components": {
            "items": {
              "$ref": "#/components/schemas/AceComponent"
            },
            "type": "array",
            "title": "Components"
          }
        },
        "type": "object",
        "required": [
          "value",
          "label"
        ],
        "title": "AceIndex",
        "description": "Tier 5 \u2014 the composite AI Capital Environment index (PROJECT_GUIDANCE \u00a78)."
      },
      "BriefingItem": {
        "properties": {
          "tone": {
            "type": "string",
            "title": "Tone"
          },
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "tone",
          "text"
        ],
        "title": "BriefingItem",
        "description": "Tier 5 \u2014 one line of the Chairman's daily briefing."
      },
      "ClarificationMode": {
        "type": "string",
        "enum": [
          "interactive",
          "auto_proceed"
        ],
        "title": "ClarificationMode",
        "description": "Controls how an ambiguous query is handled (Req 2.4)."
      },
      "Clarify": {
        "properties": {
          "original_query": {
            "type": "string",
            "title": "Original Query"
          },
          "questions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Questions"
          },
          "round": {
            "type": "integer",
            "title": "Round"
          }
        },
        "type": "object",
        "required": [
          "original_query",
          "questions",
          "round"
        ],
        "title": "Clarify",
        "description": "Refinement needs the Commander to clarify (interactive mode, Req 2.5)."
      },
      "ClarifyRequest": {
        "properties": {
          "clarified_query": {
            "type": "string",
            "title": "Clarified Query"
          },
          "round": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Round",
            "default": 1
          },
          "mode": {
            "$ref": "#/components/schemas/ClarificationMode",
            "default": "interactive"
          },
          "max_results": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 50.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Results"
          }
        },
        "type": "object",
        "required": [
          "clarified_query"
        ],
        "title": "ClarifyRequest"
      },
      "CleanedItem": {
        "properties": {
          "source_url": {
            "type": "string",
            "title": "Source Url"
          },
          "source_type": {
            "$ref": "#/components/schemas/SourceType"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "clean_text": {
            "type": "string",
            "title": "Clean Text"
          },
          "stream": {
            "$ref": "#/components/schemas/Stream"
          },
          "industry": {
            "type": "string",
            "title": "Industry"
          },
          "entities": {
            "items": {
              "$ref": "#/components/schemas/ResolvedEntity"
            },
            "type": "array",
            "title": "Entities"
          },
          "themes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Themes"
          },
          "segments": {
            "items": {
              "$ref": "#/components/schemas/TranscriptSegment"
            },
            "type": "array",
            "title": "Segments"
          },
          "published_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published At"
          },
          "ingested_at": {
            "type": "string",
            "format": "date-time",
            "title": "Ingested At"
          }
        },
        "type": "object",
        "required": [
          "source_url",
          "source_type",
          "title",
          "clean_text",
          "stream",
          "industry"
        ],
        "title": "CleanedItem",
        "description": "The unit persisted to Postgres after Data Engineering (Req 14, 15)."
      },
      "ContextPreview": {
        "properties": {
          "tracker": {
            "type": "string",
            "title": "Tracker"
          },
          "channel": {
            "type": "string",
            "title": "Channel"
          },
          "date": {
            "type": "string",
            "title": "Date"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          },
          "quote": {
            "type": "string",
            "title": "Quote"
          },
          "speaker": {
            "type": "string",
            "title": "Speaker"
          },
          "score": {
            "type": "number",
            "title": "Score"
          }
        },
        "type": "object",
        "required": [
          "tracker",
          "channel",
          "date",
          "timestamp",
          "quote",
          "speaker",
          "score"
        ],
        "title": "ContextPreview",
        "description": "Best evidence quote for a tracker (theme) + a relevance score (Core Feature \u00a77.1).\n\nSurfaced by `GET /api/trackers/{tracker}/context`. `score` is a real 0..1 semantic\nrelevance of the quote to the tracker concept \u2014 never a placeholder. Every preview is\nanchored to a real `source_url`-backed item (no-orphan guardrail \u00a712.6)."

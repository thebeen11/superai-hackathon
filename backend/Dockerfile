# Hedge Fund AI Agent Council — backend (FastAPI) for Cloud Run.
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Install deps first for layer caching. requirements.txt is generated by `uv export`.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# App code + the one-off schema bootstrap script. app/static (bundled ReDoc) ships with app/.
COPY app ./app
COPY scripts ./scripts

# Cloud Run injects $PORT (default 8080); uvicorn must bind to it on 0.0.0.0.
ENV PORT=8080
EXPOSE 8080
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT}"]

# Prod config template. Loaded when APP_ENV=prod (e.g. `cp .env.prod.example .env.prod` for a
# prod-like local run). On Cloud Run these values come from `--set-env-vars` / `--set-secrets`
# (see deploy.sh) and NO `.env.prod` file is shipped — OS env overrides any file. Do NOT commit
# real secrets here; keep them in Secret Manager.
APP_ENV=prod

# Discovery source keys — in prod these are Secret Manager secrets injected by Cloud Run.
EXA_API_KEY=
YOUTUBE_API_KEY=

DISCOVERY_MAX_RESULTS_PER_SOURCE=5

# --- Gemini on Vertex AI (reasoning) ---
# Auth is via the Cloud Run service account (ADC); it needs roles/aiplatform.user. No API keys.
GCP_PROJECT=
VERTEX_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-pro

# --- Database (Cloud SQL via the Cloud Run socket mount) ---
DATABASE_URL=postgresql+psycopg://USER:PW@/council?host=/cloudsql/PROJECT:REGION:INSTANCE


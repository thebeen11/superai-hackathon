# Local dev config. Copy to `.env.local` and fill in. Loaded when APP_ENV=local (the default).
# Discovery skips a source gracefully if its key is missing.
APP_ENV=local

# Exa (web search + crawl) — https://dashboard.exa.ai
EXA_API_KEY=

# YouTube Data API v3 (video search) — https://console.cloud.google.com
YOUTUBE_API_KEY=

# Supadata (YouTube channel subscriptions: metadata + transcripts) — https://supadata.ai
# Without it the Sources → YouTube tab is inert; the rest of the app is unaffected.
SUPADATA_API_KEY=

# Optional tuning
DISCOVERY_MAX_RESULTS_PER_SOURCE=5
# Channel ingestion. The free Supadata tier is 100 credits/month, so keep these small.
YOUTUBE_CHANNEL_BACKFILL=5
YOUTUBE_POLL_LIMIT=10
YOUTUBE_POLL_ENABLED=true
YOUTUBE_POLL_INTERVAL_MINUTES=1440

# --- Gemini on Vertex AI (reasoning) ---
# Auth is via Application Default Credentials — no API keys.
# Run `gcloud auth application-default login` once, then set your project below.
GCP_PROJECT=
# Gemini 3.x is served on the `global` endpoint; regional ones 404 on these model ids.
VERTEX_LOCATION=global
GEMINI_MODEL=gemini-3.1-pro-preview
# Tier 4 debate sides — default to 3.1 Pro (Bull) vs 3.6 Flash (Bear).
# GEMINI_BULL_MODEL=gemini-3.1-pro-preview
# GEMINI_BEAR_MODEL=gemini-3.6-flash

# --- Telegram daily report (macro indicators) ---
# Sent at the end of the daily crawl, once the council has written a fresh snapshot.
# Leave these blank and the send is skipped with a logged reason; nothing else changes.
#   1. Create a bot with @BotFather -> TELEGRAM_BOT_TOKEN
#   2. Add the bot to the channel AS AN ADMIN with "Post Messages" (a plain member gets 403)
#   3. TELEGRAM_CHAT_ID is "@channelname" for a public channel, or the numeric -100... id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_DAILY_REPORT_ENABLED=true
# Don't re-send yesterday's snapshot when a council run fails. 0 disables the check.
# TELEGRAM_REPORT_MAX_AGE_HOURS=24

# --- Database (local Postgres from docker-compose.yml) ---
DATABASE_URL=postgresql+psycopg://council:council@localhost:5433/council

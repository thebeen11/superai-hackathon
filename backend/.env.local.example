# Local dev config. Copy to `.env.local` and fill in. Loaded when APP_ENV=local (the default).
# Discovery skips a source gracefully if its key is missing.
APP_ENV=local

# Exa (web search + crawl) — https://dashboard.exa.ai
EXA_API_KEY=

# YouTube Data API v3 (video search) — https://console.cloud.google.com
YOUTUBE_API_KEY=

# Optional tuning
DISCOVERY_MAX_RESULTS_PER_SOURCE=5

# --- Gemini on Vertex AI (reasoning) ---
# Auth is via Application Default Credentials — no API keys.
# Run `gcloud auth application-default login` once, then set your project below.
GCP_PROJECT=
VERTEX_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-pro

# --- Database (local Postgres from docker-compose.yml) ---
DATABASE_URL=postgresql+psycopg://council:council@localhost:5433/council

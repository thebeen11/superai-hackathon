# Copy to .env and fill in. Discovery skips a source gracefully if its key is missing.

# Exa (web search + crawl) — https://dashboard.exa.ai
EXA_API_KEY=

# YouTube Data API v3 (video search) — https://console.cloud.google.com
YOUTUBE_API_KEY=

# Optional tuning
DISCOVERY_MAX_RESULTS_PER_SOURCE=5

# --- Bedrock (reasoning) ---
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=us.anthropic.claude-opus-4-6-v1
BEDROCK_MAX_RETRIES=3

# --- Database (RDS Postgres) ---
# e.g. postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=postgresql+psycopg://council:council@localhost:5433/council
